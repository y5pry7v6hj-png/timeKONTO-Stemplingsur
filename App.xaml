<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Stemplingsur.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PubGreen">#123D31</Color>
            <Color x:Key="PubGreenLight">#1B5746</Color>
            <Color x:Key="Cream">#F5F1E8</Color>
            <Color x:Key="WarmWhite">#FCFAF5</Color>
            <Color x:Key="Card">#FFFFFF</Color>
            <Color x:Key="Ink">#17211D</Color>
            <Color x:Key="Muted">#66736D</Color>
            <Color x:Key="Success">#27875D</Color>
            <Color x:Key="Danger">#B84A4A</Color>
            <Style TargetType="Page">
                <Setter Property="BackgroundColor" Value="{StaticResource Cream}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HeightRequest" Value="54" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
